# URL Web App Google Apps Script (/exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Harus sama dengan APP_SECRET pada Script Properties Apps Script
APP_SECRET=ganti-dengan-random-secret-yang-panjang

# Password login admin website. JANGAN awali nama variabel dengan NEXT_PUBLIC_
ADMIN_PASSWORD=ganti-password-admin

# Secret untuk menandatangani cookie login. Gunakan string random minimal 32 karakter.
SESSION_SECRET=ganti-dengan-session-secret-random-minimal-32-karakter
